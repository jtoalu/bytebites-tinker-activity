classDiagram
    class Customer {
        +name: str
        +purchase_history: list
        +add_purchase()
        +get_purchase_history()
    }

    class Item {
        +name: str
        +price: float
        +category: str
        +popularity_rating: float
        +get_price()
    }

    class ItemCatalog {
        +items: list[Item]
        +add_item(item: Item)
        +filter_by_category(category: str) list[Item]
    }

    class Transaction {
        +items: list[Item]
        +total_cost: float
        +add_item(item: Item)
        +calculate_total() float
    }

    Customer "1" --> "*" Transaction
    ItemCatalog "1" --> "*" Item
    Transaction "*" --> "*" Item

